{
  "name": "mode-stock",
  "version": "3.3.0",
  "description": "MODE Stock — gestion de stock de pièces détachées : PWA (autonome ou synchronisée par le serveur de l'entreprise)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:server && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:server": "node --test \"tests/server/*.test.js\"",
    "test:e2e": "playwright test",
    "serve": "node tests/serve.js",
    "server": "node server/index.js",
    "server:demo": "DEMO=1 DATA_DIR=server/data-demo node server/index.js",
    "vendor": "node scripts/vendor.js",
    "sw": "node scripts/sw-precache.js",
    "icons": "node scripts/icons.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "axe-core": "^4.10.0",
    "html5-qrcode": "2.3.8",
    "qrcode-generator": "1.4.4"
  }
}
