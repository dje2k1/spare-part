# ── MODE Stock : configuration du serveur (copier en .env, ne jamais committer .env) ──

# Nom de domaine public (Caddy obtient le certificat HTTPS). Indispensable : caméra, installation et hors-ligne exigent HTTPS.
DOMAIN=stock.example.com

# Code d'accès de l'entreprise : demandé UNE fois par appareil. 8 caractères ou plus, à communiquer aux équipes.
# Le changer oblige chaque appareil à le ressaisir (les sessions en cours restent valides).
ORG_CODE=

# Première installation uniquement (ignorés dès que des données existent) :
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PIN=
BOOTSTRAP_DEPOT_NAME=Entrepôt central
BOOTSTRAP_DEPOT_CODE=CEN

# Essai : DEMO=1 installe les données de démonstration (comptes et PIN visibles à la connexion). Jamais en production.
# DEMO=1

# Analyse photo (facultatif) : la clé reste sur le serveur, aucun appareil ne la voit.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=40

# Durée d'une session sans activité (heures, prolongée à chaque usage)
SESSION_HOURS=12
